{
  "name": "@agentage/extension-probe",
  "version": "0.9.3",
  "description": "The probe extension: one of every agentage part kind; it proves the kit on each release",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentage/examples.git",
    "directory": "extensions/probe"
  },
  "homepage": "https://github.com/agentage/examples/tree/master/extensions/probe#readme",
  "bugs": {
    "url": "https://github.com/agentage/examples/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "agentage": "^0.24"
  },
  "agentage": {
    "id": "probe",
    "parts": {
      "pages": true,
      "ui": true,
      "api": true,
      "mcp": true,
      "worker": true,
      "cli": true,
      "store": "postgres",
      "app": true
    },
    "app": {
      "title": "Probe",
      "icon": "radar",
      "order": 10
    },
    "commands": [
      {
        "name": "ping",
        "summary": "answer pong",
        "args": [
          {
            "name": "msg",
            "type": "string",
            "required": false
          }
        ]
      }
    ],
    "settings": {
      "echo.prefix": {
        "type": "string",
        "default": ""
      },
      "mcp.listing": {
        "type": "string",
        "enum": [
          "open",
          "token"
        ],
        "default": "open"
      }
    }
  },
  "exports": {
    "./agentage-extension.json": "./dist/agentage-extension.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "openapi.json",
    "probe.mcpc.json",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && agentage-widget bundle && node node_modules/@agentage/extension/dist/tool/cli.js app",
    "type-check": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "verify": "npm run type-check && npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@agentage/extension": "^0.24.0",
    "express": "^5.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@agentage/cli": "^0.75.0",
    "@agentage/components": "0.21.0",
    "@agentage/widget": "0.6.0",
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "4.14.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "keywords": [
    "agentage",
    "agentage-extension"
  ],
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
