{
  "openapi": "3.1.0",
  "info": {
    "title": "fixture",
    "version": "0.2.21"
  },
  "components": {
    "securitySchemes": {
      "pat": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "agcid": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "details": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": ["field", "message"],
                      "additionalProperties": false
                    }
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                ]
              }
            },
            "required": ["code", "message", "agcid"],
            "additionalProperties": false
          }
        },
        "required": ["success", "error"],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/api/fixture/echo": {
      "get": {
        "summary": "Echo msg",
        "security": [
          {
            "pat": ["fixture:read"]
          }
        ],
        "parameters": [
          {
            "name": "msg",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "msg": {
                          "type": "string"
                        },
                        "caller": {
                          "type": "string"
                        }
                      },
                      "required": ["msg", "caller"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/fixture/ping": {
      "get": {
        "summary": "Answer pong",
        "security": [],
        "responses": {
          "200": {
            "description": "the envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "msg": {
                          "type": "string"
                        },
                        "pings": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": ["msg", "pings"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          }
        }
      }
    },
    "/api/fixture/installations/{target}": {
      "get": {
        "summary": "The installation document of a target",
        "security": [],
        "parameters": [
          {
            "name": "target",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "target": {
                          "type": "string"
                        },
                        "deployments": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "url": {
                                "type": "string"
                              }
                            },
                            "required": ["id", "url"],
                            "additionalProperties": false
                          }
                        },
                        "routes": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "column"
                              },
                              "children": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "widget"
                                    },
                                    "extension": {
                                      "type": "string"
                                    },
                                    "name": {
                                      "type": "string"
                                    }
                                  },
                                  "required": ["kind", "extension", "name"],
                                  "additionalProperties": false
                                }
                              }
                            },
                            "required": ["kind", "children"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": ["target", "deployments", "routes"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
